deploy/artifacts/

*.log      # 屏蔽运行日志文件
# macOS launcher built by `python -m gui.make_app` (paths are machine-specific)
*.app/
.build/
dist/

# GUI evaluation output: one timestamped folder per Evaluate-tab run.
# Figures you want to keep (the paper's) live directly in figures/.
figures/gui_eval_*/

# Saved EEG-IO comparisons, one JSON per run of the EEG-IO test tab. They
# describe recordings that are not redistributable, and they are
# reproducible from the runs they name.
eegio_tests/

# Stray session-id file written to the project root by a tool run.
:memory:*
